+  "expected": "<bos><|turn>system\nUse tools.<|tool>declaration:record_note{description:<|\"|>Record a note.<|\"|>,parameters:{properties:{entries:{items:{properties:{amount:{description:<|\"|>Amount.<|\"|>,type:<|\"|>NUMBER<|\"|>}},required:[<|\"|>amount<|\"|>],title:<|\"|>Entry<|\"|>,type:<|\"|>OBJECT<|\"|>},type:<|\"|>ARRAY<|\"|>},mode:{enum:[<|\"|>short<|\"|>,<|\"|>full<|\"|>],type:<|\"|>STRING<|\"|>},options:{properties:{active:{type:<|\"|>BOOLEAN<|\"|>},label:{nullable:true,type:<|\"|>STRING<|\"|>}},required:[<|\"|>active<|\"|>],type:<|\"|>OBJECT<|\"|>},title:{description:<|\"|>Exact note title.<|\"|>,type:<|\"|>STRING<|\"|>}},required:[<|\"|>title<|\"|>,<|\"|>entries<|\"|>],type:<|\"|>OBJECT<|\"|>}}<tool|><|tool>declaration:list_notes{description:<|\"|>List notes.<|\"|>}<tool|><turn|>\n<|turn>user\nSave a note.<turn|>\n<|turn>model\n"
+}
diff --git a/Tests/Qwen3ChatTests/Gemma4CanonicalFormatTests.swift b/Tests/Qwen3ChatTests/Gemma4CanonicalFormatTests.swift
