+++ b/Tests/Qwen3ChatTests/Gemma4CanonicalFormatTests.swift
@@ -0,0 +1,124 @@
+import Foundation
+import XCTest
+@testable import Qwen3Chat
+
+final class Gemma4CanonicalFormatTests: XCTestCase {
+    func testNonThinkingToolContinuationPreservesTheOpenModelTurn() throws {
+        let call = Gemma4ToolCall(id: "read-1", name: "read_record", arguments: .object([:]))
+        let raw = try Gemma4ToolCodec.prompt(messages: [
+            .init(role: .user, content: "Read it."),
+            .init(role: .assistant, toolCalls: [call], reasoningContent: "Check the returned marker."),
+            .init(role: .tool, content: "ready", toolCallID: call.id)
+        ])
+        let prompt = Gemma4ToolCodec.nonThinkingGenerationPrompt(raw)
+        XCTAssertEqual(prompt, raw + "<|channel>thought\n<channel|>")
+        XCTAssertTrue(prompt.contains("Check the returned marker."))
+        XCTAssertTrue(prompt.hasSuffix("<tool_response|><|channel>thought\n<channel|>"))
+        XCTAssertEqual(prompt.components(separatedBy: "<|turn>model\n").count - 1, 1)
+    }
+
+    func testNonThinkingPrefixIsIdempotentAndDoesNotRewriteCompletedText() {
+        let raw = "<bos><|turn>user\nHello<turn|>\n<|turn>model\n"
+        let prefixed = Gemma4ToolCodec.nonThinkingGenerationPrompt(raw)
+        XCTAssertEqual(prefixed, raw + "<|channel>thought\n<channel|>")
+        XCTAssertEqual(Gemma4ToolCodec.nonThinkingGenerationPrompt(prefixed), prefixed)
+        let completed = raw + "Hello.<turn|>\n"
+        XCTAssertEqual(Gemma4ToolCodec.nonThinkingGenerationPrompt(completed), completed)
+    }
+
+    func testCanonicalDeclarationsMatchPinnedReferenceWithoutDroppingTitleArgument() throws {
+        struct Fixture: Decodable {
+            let tools: [Gemma4Tool]
+            let expected: String
+        }
+        let path = try XCTUnwrap(Bundle.module.url(forResource: "gemma4-canonical-tools", withExtension: "json", subdirectory: "Fixtures"))
+        let fixture = try JSONDecoder().decode(Fixture.self, from: Data(contentsOf: path))
+        let messages: [Gemma4ConversationMessage] = [
+            .init(role: .system, content: "Use tools."),
+            .init(role: .user, content: "Save a note.")
+        ]
+        let prompt = try Gemma4ToolCodec.prompt(messages: messages, tools: fixture.tools,
+                                               preserveToolResponseText: true, canonicalDeclarations: true)
+        XCTAssertEqual(prompt, fixture.expected)
+        XCTAssertTrue(prompt.contains("title:{description:"))
+        XCTAssertFalse(prompt.contains("Display label"))
+        // The legacy declaration path stays available for E4B checkpoints.
+        XCTAssertTrue(try Gemma4ToolCodec.prompt(messages: messages, tools: fixture.tools).contains("Display label"))
+    }
+
+    func testReasoningIsSeparatedFromSpeechAndNeverDispatchesItsExampleCall() throws {
+        let reply = try Gemma4ToolCodec.response("""
+        <|channel>thought
+        Check first. Example: <|tool_call>call:wrong{}<tool_call|>
+        <channel|><|tool_call>call:read_record{id:<|"|>record_7<|"|>}<tool_call|>
+        """)
+        XCTAssertEqual(reply.toolCalls.map(\.name), ["read_record"])
+        XCTAssertEqual(reply.content, "")
+        XCTAssertEqual(reply.reasoningContent, "Check first. Example: <|tool_call>call:wrong{}<tool_call|>")
+        let spoken = try Gemma4ToolCodec.response("<|channel>thought\nKeep this internal.<channel|>The record is ready.<turn|>")
+        XCTAssertEqual(spoken.content, "The record is ready.")
+        XCTAssertEqual(spoken.reasoningContent, "Keep this internal.")
+    }
+
+    func testReasoningSurvivesToolContinuationAndIsStrippedAfterNewUserTurn() throws {
+        let call = Gemma4ToolCall(id: "read-1", name: "read_record", arguments: .object([:]))
+        let messages: [Gemma4ConversationMessage] = [
+            .init(role: .user, content: "Read the record."),
+            .init(role: .assistant, toolCalls: [call], reasoningContent: "Check this unique marker first."),
+            .init(role: .tool, content: "ready", toolCallID: call.id)
+        ]
+        let continuation = try Gemma4ToolCodec.prompt(messages: messages)
+        XCTAssertTrue(continuation.contains("<|channel>thought\nCheck this unique marker first.\n<channel|><|tool_call>"))
+        XCTAssertTrue(continuation.hasSuffix("<tool_response|>"))
+        let nextTurn = try Gemma4ToolCodec.prompt(messages: messages + [.init(role: .user, content: "What next?")])
+        XCTAssertFalse(nextTurn.contains("Check this unique marker first."))
+        XCTAssertTrue(nextTurn.contains("<tool_response|><turn|>\n<|turn>user\nWhat next?"))
+    }
+
+    func testLegacyWirePayloadsDecodeWithoutReasoningAndNewPayloadsRoundTrip() throws {
+        let legacy = try JSONDecoder().decode(Gemma4Response.self, from: Data("{\"content\":\"Ready\",\"toolCalls\":[],\"generatedTokens\":1}".utf8))
+        XCTAssertNil(legacy.reasoningContent)
+        let reply = Gemma4Response(content: "Ready", toolCalls: [], generatedTokens: 3, reasoningContent: "Private intermediate step.")
+        XCTAssertEqual(try JSONDecoder().decode(Gemma4Response.self, from: JSONEncoder().encode(reply)), reply)
+        let message = try JSONDecoder().decode(Gemma4ConversationMessage.self, from: Data("{\"role\":\"user\",\"content\":\"Hello\"}".utf8))
+        XCTAssertNil(message.reasoningContent)
+    }
+
+    func testMalformedReasoningAndPartialCallsRemainErrors() throws {
+        for raw in ["<|channel>thought\nunfinished", "<|channel>unknown\ntext<channel|>Ready",
+                    "<|tool_call>call:calculate{expression:<|\"|>1 +",
+                    "<|tool_call>call:broken<tool_call|><|tool_call>call:valid{}<tool_call|>"] {
+            XCTAssertThrowsError(try Gemma4ToolCodec.response(raw))
+        }
+    }
+
+    func testNestedReasoningCannotExposeAnExampleCallForDispatch() {
+        let raw = "<|channel>thought\nExample: <|channel>thought\ninner<channel|><|tool_call>call:wrong{}<tool_call|><channel|>"
+        XCTAssertThrowsError(try Gemma4ToolCodec.response(raw))
+    }
+
+    func testQuotedControlMarkersRemainLiteralToolArguments() throws {
+        let literal = "Keep <|channel>unknown\nprivate?<channel|> and <|tool_call>call:wrong{}<tool_call|> literally."
+        let json = String(decoding: try JSONEncoder().encode(literal), as: UTF8.self)
+        for quoted in ["<|\"|>" + literal + "<|\"|>", json] {
+            let raw = "<|tool_call>call:record_note{text:" + quoted + "}<tool_call|>"
+            let reply = try Gemma4ToolCodec.response(raw)
+            XCTAssertEqual(reply.toolCalls.map(\.name), ["record_note"])
+            XCTAssertEqual(reply.toolCalls.first?.arguments, .object(["text": .string(literal)]))
+            XCTAssertNil(reply.reasoningContent)
+            XCTAssertEqual(reply.content, "")
+        }
+    }
+
+    func testReasoningBetweenCallsNeverDispatchesItsExampleCall() throws {
+        let reply = try Gemma4ToolCodec.response("""
+        <|tool_call>call:first{text:<|"|><|channel>thought\nquoted<channel|><|"|>}<tool_call|>
+        <|channel>thought\nExample: <|tool_call>call:wrong{}<tool_call|>\n<channel|>
+        <|tool_call>call:second{ok:true}<tool_call|>
+        """)
+        XCTAssertEqual(reply.toolCalls.map(\.name), ["first", "second"])
+        XCTAssertEqual(reply.toolCalls.first?.arguments, .object(["text": .string("<|channel>thought\nquoted<channel|>")]))
+        XCTAssertEqual(reply.reasoningContent, "Example: <|tool_call>call:wrong{}<tool_call|>")
+        XCTAssertEqual(reply.content, "")
+    }
+}
